{
  "name": "url-shortener",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && concurrently --names api,web \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter web build",
    "test": "pnpm -r test",
    "demo": "bash scripts/demo.sh",
    "lint": "biome check .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "concurrently": "10.0.5"
  }
}
